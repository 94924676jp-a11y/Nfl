+#: How many players at each position START, the formation this codebase already declares
+#: (classic_slate_state.NO_USAGE_CHART_LIFT_LIMIT: "one RB and one TE start, three WRs start"). CEILING_BY_EVIDENCE
+#: is read at the rank BEYOND the starters, so a club's WR2 and WR3 -- starters -- are not capped as backups.
+#: MEASURED before this change (2021-2026 player-weeks, pregame usage rank, realised share band): a rank-2 WR realised
+#: a role above the old SECONDARY cap in 50% of 1,890 weeks (23% ALPHA), against 18% for a rank-2 RB and 10% for a
+#: rank-2 TE. The one-ALPHA-per-room rule still orders the starters, so WR2 lands at PRIMARY when WR1 is ALPHA.
+STARTERS_BY_POSITION = {'QB': 1, 'RB': 1, 'TE': 1, 'WR': 3}
+
+
+def _ceiling_rank(rank, pos):
+    """Position depth rank -> the rank CEILING_BY_EVIDENCE is read at: every starter reads rank 1."""
+    return max(1, rank - (STARTERS_BY_POSITION.get(pos, 1) - 1))
+
